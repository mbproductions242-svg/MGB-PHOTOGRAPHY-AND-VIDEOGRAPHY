<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard · Studio Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#14140f" />
  <link rel="icon" href="/icons/icon-192.png" type="image/png" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="MGB Galleries" />
  <script src="/js/pwa.js" defer></script>
</head>
<body>
  <div class="container">
    <div class="topbar">
      <div class="brand">Studio <span>Admin</span></div>
      <nav>
        <span>Hi, <%= adminName %></span>
        <form method="POST" action="/admin/logout" style="display:inline">
          <button class="btn btn-outline btn-sm" type="submit">Log Out</button>
        </form>
      </nav>
    </div>

    <div class="page-head">
      <h1>Galleries</h1>
      <a class="btn btn-accent" href="/admin/galleries/new">+ New Gallery</a>
    </div>

    <div class="stat-row">
      <div class="stat-card">
        <div class="num"><%= galleries.length %></div>
        <div class="label">Galleries</div>
      </div>
      <div class="stat-card">
        <div class="num"><%= galleries.filter(g => g.status === 'published').length %></div>
        <div class="label">Published</div>
      </div>
      <div class="stat-card">
        <div class="num"><%= clients.length %></div>
        <div class="label">Clients</div>
      </div>
      <div class="stat-card">
        <div class="num"><%= galleries.reduce((s, g) => s + g.photo_count, 0) %></div>
        <div class="label">Photos</div>
      </div>
    </div>

    <div class="two-col">
      <div>
        <div class="panel">
          <h2>All galleries</h2>
          <% if (galleries.length === 0) { %>
            <div class="empty-state">
              <p>No galleries yet. Create your first one to get started.</p>
            </div>
          <% } else { %>
            <div class="gallery-list">
              <% galleries.forEach(g => { %>
                <a class="gallery-row" href="/admin/galleries/<%= g.id %>">
                  <div>
                    <div class="title"><%= g.title %></div>
                    <div class="meta">
                      <%= g.client_name %> · <%= g.photo_count %> photos · <%= g.favorite_count %> favorited
                      <% if (g.shoot_date) { %> · <%= g.shoot_date %><% } %>
                    </div>
                  </div>
                  <span class="badge <%= g.status %>"><%= g.status %></span>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <div>
        <div class="panel">
          <h2>Add a client</h2>
          <p style="margin-top:-8px;font-size:13px;">Add a client, then create a gallery for them.</p>
          <form method="POST" action="/admin/clients">
            <div class="field">
              <label for="name">Client name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="field">
              <label for="email">Client email (optional)</label>
              <input type="email" id="email" name="email" />
            </div>
            <button class="btn btn-block" type="submit">Add Client &amp; Continue</button>
          </form>
        </div>

        <div class="panel">
          <h2>Existing clients</h2>
          <% if (clients.length === 0) { %>
            <p>No clients yet.</p>
          <% } else { %>
            <div class="gallery-list">
              <% clients.forEach(c => { %>
                <a class="gallery-row" href="/admin/galleries/new?client_id=<%= c.id %>">
                  <div>
                    <div class="title" style="font-size:15px;"><%= c.name %></div>
                    <% if (c.email) { %><div class="meta"><%= c.email %></div><% } %>
                  </div>
                  <span class="badge">+ Gallery</span>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="footer-note">Photo gallery admin</div>
  </div>
</body>
</html>
