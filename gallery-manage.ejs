<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= gallery.title %> · Studio Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#14140f" />
  <link rel="icon" href="/icons/icon-192.png" type="image/png" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="MGB Galleries" />
  <script src="/js/pwa.js" defer></script>
</head>
<body>
  <div class="container">
    <div class="topbar">
      <div class="brand">Studio <span>Admin</span></div>
      <nav><a class="btn btn-outline btn-sm" href="/admin">← Dashboard</a></nav>
    </div>

    <div class="page-head">
      <div>
        <h1><%= gallery.title %></h1>
        <p style="margin-top:-6px;">
          For <strong><%= gallery.client_name %></strong>
          · <span class="badge <%= gallery.status %>"><%= gallery.status %></span>
          <% if (gallery.approved) { %> · <span class="badge published">Client approved</span><% } %>
        </p>
      </div>
      <div style="display:flex;gap:8px;">
        <% if (photos.some(p => p.is_favorited)) { %>
          <a class="btn btn-outline btn-sm" href="/admin/galleries/<%= gallery.id %>/download-favorites">Download Selects</a>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <h2>Share with client</h2>
      <div class="copy-link-row">
        <code id="gallery-link"><%= galleryUrl %></code>
        <button class="btn btn-sm" type="button" onclick="copyLink()">Copy</button>
      </div>
      <p style="font-size:13px;">
        <% if (gallery.status !== 'published') { %>
          This gallery is still a <strong>draft</strong> — publish it below before sharing the link.
        <% } else if (gallery.access_password_hash) { %>
          Password-protected. Share the password with your client separately.
        <% } else { %>
          No password set — anyone with the link can view this gallery.
        <% } %>
      </p>
    </div>

    <div class="two-col">
      <div>
        <div class="panel">
          <h2>Upload photos</h2>
          <form id="upload-form" method="POST" action="/admin/galleries/<%= gallery.id %>/upload" enctype="multipart/form-data">
            <label class="dropzone" id="dropzone">
              <div id="dropzone-label">Tap to choose photos, or drag &amp; drop here<br /><small>JPG/PNG · multiple files supported</small></div>
              <input type="file" name="photos" id="file-input" accept="image/*" multiple />
            </label>
            <button class="btn btn-accent btn-block" type="submit" style="margin-top:12px;" id="upload-btn">Upload</button>
          </form>
        </div>

        <div class="panel">
          <h2>Photos (<%= photos.length %>)</h2>
          <% if (photos.length === 0) { %>
            <div class="empty-state"><p>No photos uploaded yet.</p></div>
          <% } else { %>
            <div class="photo-grid">
              <% photos.forEach(p => { %>
                <div class="photo-tile">
                  <img src="/admin/photo-thumb/<%= p.id %>" loading="lazy" alt="" />
                  <% if (p.is_favorited) { %><div class="fav-btn active">♥</div><% } %>
                  <form method="POST" action="/admin/photos/<%= p.id %>/delete" onsubmit="return confirm('Delete this photo?');">
                    <button class="admin-del" type="submit">Delete</button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <div>
        <div class="panel">
          <h2>Gallery settings</h2>
          <form method="POST" action="/admin/galleries/<%= gallery.id %>/settings">
            <div class="field">
              <label for="title">Title</label>
              <input type="text" id="title" name="title" value="<%= gallery.title %>" required />
            </div>
            <div class="field">
              <label for="shoot_date">Shoot date</label>
              <input type="date" id="shoot_date" name="shoot_date" value="<%= gallery.shoot_date || '' %>" />
            </div>
            <div class="field">
              <label for="expiration_date">Expires on</label>
              <input type="date" id="expiration_date" name="expiration_date" value="<%= gallery.expiration_date || '' %>" />
            </div>
            <div class="field">
              <label for="access_password">Gallery password</label>
              <input type="text" id="access_password" name="access_password" placeholder="<%= gallery.access_password_hash ? 'Leave blank to keep current password' : 'No password set' %>" />
              <small>Clear this field's placeholder by typing then deleting to remove password protection.</small>
            </div>
            <div class="field">
              <label for="max_selections">Selection limit</label>
              <input type="number" id="max_selections" name="max_selections" min="1" value="<%= gallery.max_selections || '' %>" />
            </div>
            <div class="checkbox-row">
              <input type="checkbox" id="watermark_enabled" name="watermark_enabled" <%= gallery.watermark_enabled ? 'checked' : '' %> />
              <label for="watermark_enabled">Watermark preview images</label>
            </div>
            <div class="checkbox-row">
              <input type="checkbox" id="downloads_enabled" name="downloads_enabled" <%= gallery.downloads_enabled ? 'checked' : '' %> />
              <label for="downloads_enabled">Allow full-resolution downloads</label>
            </div>
            <div class="field">
              <label for="status">Status</label>
              <select id="status" name="status">
                <option value="draft" <%= gallery.status === 'draft' ? 'selected' : '' %>>Draft (hidden from client)</option>
                <option value="published" <%= gallery.status === 'published' ? 'selected' : '' %>>Published (visible via link)</option>
              </select>
            </div>
            <button class="btn btn-accent btn-block" type="submit">Save Settings</button>
          </form>
        </div>

        <div class="panel">
          <h2>Recent client comments</h2>
          <% if (comments.length === 0) { %>
            <p>No comments yet.</p>
          <% } else { %>
            <% comments.forEach(c => { %>
              <div style="padding:8px 0;border-bottom:1px solid var(--line);font-size:13.5px;">
                <strong><%= c.original_filename || 'Photo' %>:</strong> <%= c.body %>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="panel">
          <h2 style="color:var(--danger);">Danger zone</h2>
          <form method="POST" action="/admin/galleries/<%= gallery.id %>/delete" onsubmit="return confirm('Delete this entire gallery and all photos? This cannot be undone.');">
            <button class="btn btn-danger btn-block" type="submit">Delete Gallery</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
